{
  "name": "12 Schedule every 10 seconds",
  "nodes": [
    {
      "id": "1",
      "name": "Every 10 seconds",
      "type": "flowforge.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Tick",
      "type": "flowforge.set",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "tick",
              "value": "={{ $json['Readable time'] }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 10 seconds": {
      "main": [
        [
          {
            "node": "Tick",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
