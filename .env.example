# Atlas Flow configuration. Copy to `.env` and fill in what you need.
# Guide en francais et tests pas a pas : CONFIGURATION_API.md
# Every variable is optional: Atlas Flow starts without a .env file.

# ── Server ────────────────────────────────────────────────────────────────
# Port of the web UI + API (n8n uses 5678, so both can run side by side).
PORT=5679
# Interface to listen on. 0.0.0.0 = reachable from your phone on the same Wi-Fi.
HOST=0.0.0.0
# Public base URL used for webhook / form URLs and QR codes.
# Empty = auto-detected LAN address, e.g. http://192.168.1.20:5679
# For a Cloudflare quick tunnel, put the https://….trycloudflare.com URL here.
PUBLIC_URL=
# Where the database, binary files and the encryption key are stored (default: ./data).
FLOWFORGE_DATA_DIR=
# Optional: force the SQLite driver (better-sqlite3 | node). Empty = better-sqlite3, else Node's built-in node:sqlite (Node 22.13+).
# FLOWFORGE_SQLITE_DRIVER=
# How long a login session stays valid, in days.
SESSION_TTL_DAYS=7
# debug | info | warn | error
LOG_LEVEL=info

# ── Workflow engine ──────────────────────────────────────────────────────
# Default execution timeout in seconds (0 = none). A workflow setting can override it.
EXECUTION_TIMEOUT_SECONDS=300
# How many executions may run at the same time (the rest wait in a queue).
MAX_CONCURRENT_EXECUTIONS=5
# Loop guard: a run stops after this many node executions.
MAX_NODE_RUNS=10000
# Timezone for $now, dates and schedules (empty = this computer's timezone), e.g. Europe/Paris
GENERIC_TIMEZONE=Africa/Casablanca
# Allow {{ $env.X }} in expressions (variables that look like secrets are always hidden).
FLOWFORGE_ALLOW_ENV_ACCESS=true
# Code node limits.
FLOWFORGE_CODE_TIMEOUT_SECONDS=10
FLOWFORGE_CODE_MEMORY_MB=128
# Development endpoint POST /api/dev/run (run a workflow JSON with curl). Set to false to disable.
FLOWFORGE_DEV_API=true
# Waits up to this many seconds stay in memory; longer waits are saved and survive a restart.
FLOWFORGE_WAIT_IN_MEMORY_MAX_SECONDS=65

# ── Triggers & webhooks ─────────────────────────────────────────────────
# Folder the file nodes / Local File Trigger may use (default: ./data/files).
FLOWFORGE_FILES_DIR=
# Maximum webhook request body size, in MB.
WEBHOOK_MAX_BODY_MB=16
# Requests per minute per client IP on the public URLs (/webhook…, /form…).
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# Public forms: submissions per minute per visitor (anti-spam) and maximum upload size in MB.
FORM_RATE_LIMIT_PER_MINUTE=30
FORM_MAX_UPLOAD_MB=10

# ── Credentials ───────────────────────────────────────────────────────────
# Key that encrypts saved credentials (AES-256-GCM). Empty = generated once in data/.encryption_key.
# Keep it (or that file) with your database backup: without it saved credentials cannot be read.
FLOWFORGE_ENCRYPTION_KEY=

# ── Email (SMTP) ─ see API_SETUP.md#email-smtp ────────────────────────────
# Recommande : Connexions > Add credential > SMTP > Gmail, puis Test et Save.
# Le bouton Test verifie la connexion ; npm run check:email envoie un vrai email.
# Fallback when no SMTP credential is saved on the Credentials page.
# Gmail: smtp.gmail.com, port 465, your address, and an App Password
#        (https://myaccount.google.com/apppasswords), NOT your normal password.
# Brevo: smtp-relay.brevo.com, port 587, the SMTP login and SMTP key from https://app.brevo.com/settings/keys/smtp
SMTP_HOST=
SMTP_PORT=
# true for port 465, false for 587. Empty = chosen from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender used when a Send Email node leaves "From Email" empty, e.g. FlowForge <you@gmail.com>
SMTP_FROM=
# Verify with: npm run check:email

# Recipient of the test email of `npm run check` (optional), e.g. you@gmail.com
CHECK_EMAIL_TO=
# Optional: default recipient of `npm run check:email` (default: SMTP_USER). Format: you@gmail.com
# SMTP_TEST_TO=

# ── Telegram ─ see API_SETUP.md#telegram ──────────────────────────────────
# Fallback when no "Telegram Bot" credential is saved on the Credentials page.
# Token from @BotFather (/newbot), format 123456789:AAH… (digits, a colon, then letters and digits).
TELEGRAM_BOT_TOKEN=
# Optional: chat that receives messages when a Telegram node leaves "Chat ID" empty, and the test message of
# `npm run check`. A number such as 123456789 (your own chat with the bot) or -1001234567890 (a group).
TELEGRAM_CHAT_ID=
# Optional: Telegram Bot API server (default https://api.telegram.org). Change it only for a proxy or a local Bot API server.
# TELEGRAM_API_URL=

# ── Discord ─ see API_SETUP.md#discord ────────────────────────────────────
# Fallback when no "Discord Webhook" credential is saved.
# Channel settings → Integrations → Webhooks → Copy Webhook URL.
# Format: https://discord.com/api/webhooks/<numbers>/<long token>
DISCORD_WEBHOOK_URL=

# ── Google Gemini ─ see API_SETUP.md#google-gemini ────────────────────────
# Fallback when no "Google Gemini API" credential is saved. Create the key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model used when a node leaves the model on "Default" (default: gemini-3.8-flash).
GEMINI_MODEL=
# Optional: Gemini API host (default https://generativelanguage.googleapis.com). Change it only for a proxy.
# GEMINI_API_URL=

# ── Weather (Open-Meteo) ──────────────────────────────────────────────────
# No key and no variable needed.

# Verify everything with: npm run check        (add `-- --send` to also post a Discord test message)
